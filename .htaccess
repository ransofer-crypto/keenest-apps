# Keenest apps (app.keenest.co.il)
Options -Indexes
DirectoryIndex index.html
# worker/ and tools/ are code for the office Mac and for building, not web pages
RedirectMatch 404 ^/(worker|tools)(/.*)?$
RedirectMatch 404 /\.git
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# files the sites saved (pictures, videos): kept in Supabase Storage, same ids as on the old Claude pages
RedirectMatch 302 ^/(?:[a-z-]+/)?_blob/([A-Za-z0-9_-]+)$ https://ccqpmbcytrcxngnlooon.supabase.co/storage/v1/object/public/assets/$1
